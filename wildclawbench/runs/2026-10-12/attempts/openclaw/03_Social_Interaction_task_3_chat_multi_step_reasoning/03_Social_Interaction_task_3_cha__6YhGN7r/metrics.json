      "discount_deadlock": {
        "raw_score": 0.7,
        "earned": 0.056,
        "max": 0.08,
        "reason": "Identifies the approval deadlock, the >12% written-CFO-approval requirement, and why CEO verbal authorization is insufficient. It also notes that exceptions require CFO approval and suggests reducing the discount or delaying the proposal. However, it does not clearly state that CFO Linda is unavailable until March 20 or explicitly present Nina’s three options against the March 18 deadline, instead treating the dates as uncertain."
      },
      "bridgelink_dual_site_cost": {
        "raw_score": 1.0,
        "earned": 0.08,
        "max": 0.08,
        "reason": "Explicitly identifies BridgeLink, ECC 6.0 support across EHP levels, the 3–4-week implementation estimate, two required instances for Chicago/Dublin costing approximately $160K/year, confirmed EHP 7, and the outstanding InfoSec vendor assessment taking about three weeks. Also correctly excludes ECC 5.0 from scope."
      },
      "ceo_override_risk": {
        "raw_score": 1.0,
        "earned": 0.08,
        "max": 0.08,
        "reason": "Explicitly identifies the CEO's override and compressed review as governance/compliance risks, lists all four unchecked legal areas (DTIA, SAP integration SOW, 99.95% SLA liability, and BridgeLink sublicensing), and states that the 15% discount remains non-compliant without CFO written approval. Also calls for documenting residual-risk acknowledgment without treating it as an approval waiver."
      },
